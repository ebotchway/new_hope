// LivingHope platform schema
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

enum Role {
  DONOR
  STAFF
  ADMIN
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  phone                String?
  passwordHash         String?
  role                 Role      @default(DONOR)
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  accounts      Account[]
  sessions      Session[]
  sponsorships  Sponsorship[]
  donations     Donation[]
  cmsRevisions  CmsRevision[]
  cmsAuditLogs  CmsAuditLog[]
  cmsMediaAssets CmsMediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------- Children & sponsorship ----------

enum ChildStatus {
  AVAILABLE
  SPONSORED
  GRADUATED
}

enum Gender {
  MALE
  FEMALE
}

model Child {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  gender      Gender
  dateOfBirth DateTime?
  bio         String      @db.Text
  photoUrl    String?
  school      String?
  location    String?
  status      ChildStatus @default(AVAILABLE)
  featured    Boolean     @default(false)
  archived    Boolean     @default(false)
  order       Int         @default(0)

  /// Optional funding goal (in cents) to show a sponsorship progress bar; 0 = no goal shown.
  fundingGoalCents Int @default(0)

  sponsorships Sponsorship[]
  donations    Donation[]
  updates      ChildUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured, order])
  @@index([archived])
  @@map("children")
}

model ChildUpdate {
  id       String  @id @default(cuid())
  childId  String
  child    Child   @relation(fields: [childId], references: [id], onDelete: Cascade)

  title    String
  body     String  @db.Text
  imageUrl String?

  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([childId, published])
  @@map("child_updates")
}

enum SponsorshipType {
  FULL
  CONTRIBUTION
}

enum SponsorshipStatus {
  ACTIVE
  PAUSED
  ENDED
}

model Sponsorship {
  id      String  @id @default(cuid())
  userId  String?
  childId String

  guestName  String?
  guestEmail String?
  guestPhone String?

  type   SponsorshipType
  status SponsorshipStatus @default(ACTIVE)

  stripeSubscriptionId String? @unique
  monthlyAmountCents   Int

  startDate DateTime  @default(now())
  endDate   DateTime?

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  child Child  @relation(fields: [childId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([childId])
  @@index([status])
  @@map("sponsorships")
}

// ---------- Donations ----------

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum DonationDesignation {
  GENERAL
  CHILD_SPONSORSHIP
  PARTNERSHIP
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
}

model Donation {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  childId String?
  child   Child?  @relation(fields: [childId], references: [id], onDelete: SetNull)

  title       String?
  donorName   String
  donorEmail  String
  donorPhone  String?
  anonymous   Boolean @default(false)

  amountCents Int
  currency    String @default("usd")

  frequency    DonationFrequency
  designation  DonationDesignation @default(GENERAL)
  status       DonationStatus      @default(PENDING)
  paymentMethod PaymentMethod      @default(CARD)

  emailUpdates    Boolean @default(true)
  smsUpdates      Boolean @default(false)
  whatsappUpdates Boolean @default(false)

  stripeCheckoutSessionId String? @unique
  stripeInvoiceId         String? @unique
  stripePaymentIntentId   String? @unique
  stripeSubscriptionId    String?
  stripeCustomerId        String?

  /// Human-friendly reference the donor is asked to quote (e.g. "LH-4F82Q") when paying by
  /// mobile money, so staff can match the MoMo SMS/statement line to this donation.
  momoReference       String?   @unique
  momoVerifiedAt      DateTime?
  momoVerifiedBy      String?
  momoRejectionReason String?
  exchangeRate        Float?
  amountGhsCents      Int?

  receiptSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([childId])
  @@index([status, createdAt])
  @@index([paymentMethod, status])
  @@index([stripeSubscriptionId])
  @@map("donations")
}

// ---------- Partnership inquiries ----------

enum PartnershipType {
  INDIVIDUAL
  GROUP
  CORPORATE
  CHURCH
  WILL_GIFT
  VOLUNTEER
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model PartnershipInquiry {
  id      String          @id @default(cuid())
  type    PartnershipType
  name    String
  email   String
  phone   String?
  message String?         @db.Text
  status  InquiryStatus   @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("partnership_inquiries")
}

// ---------- Site content (admin-managed) ----------

model Story {
  id        String  @id @default(cuid())
  name      String
  age       Int?
  quote     String  @db.Text
  mediaUrl  String?
  imageUrl  String?
  published Boolean @default(true)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@map("stories")
}

model ImpactStat {
  id        String @id @default(cuid())
  label     String
  value     String
  order     Int    @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@map("impact_stats")
}

model HistoryEvent {
  id          String   @id @default(cuid())
  year        String
  title       String
  bulletPoints String[] @default([])
  imageUrl    String?
  order       Int      @default(0)
  published   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@map("history_events")
}

model Trustee {
  id       String  @id @default(cuid())
  name     String
  photoUrl String?
  title    String?
  order    Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@map("trustees")
}

model SiteSettings {
  id Int @id @default(1)

  heroHeadline    String @default("Transforming Lives Through Education")
  heroSubheadline String @default("Providing access to education for a brighter future")
  missionTitle    String @default("Our Guiding Mission")
  missionBody     String @default("") @db.Text

  facebookUrl String?
  twitterUrl  String?
  youtubeUrl  String?

  contactEmail String?
  contactPhone String?

  /// Mobile money merchant details shown to donors who choose to pay via MoMo instead of card.
  momoProvider     String? @default("MTN Mobile Money")
  momoNumber       String?
  momoName         String?
  momoRateUsdToGhs Float?  @default(15.5)
  momoInstructions String? @db.Text

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ---------- CMS (Phase 2 Website Management) ----------

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NavMenu {
  HEADER
  FOOTER_COL1
  FOOTER_COL2
  FOOTER_COL3
  FOOTER_LEGAL
}

model CmsPage {
  id                  String      @id @default(cuid())
  slug                String      @unique
  title               String
  publicTitle         String?
  description         String?
  status              PageStatus  @default(DRAFT)
  publishedRevisionId String?
  isSystem            Boolean     @default(false)
  seoTitle            String?
  seoDescription      String?
  ogImageUrl          String?
  canonicalUrl        String?
  noIndex             Boolean     @default(false)
  publishedAt         DateTime?

  revisions           CmsRevision[]
  auditLogs           CmsAuditLog[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([status])
  @@index([slug])
  @@map("cms_pages")
}

model CmsRevision {
  id             String    @id @default(cuid())
  pageId         String
  revisionNumber Int
  authorId       String?
  authorName     String?
  sections       Json
  changelog      String?
  createdAt      DateTime  @default(now())

  page           CmsPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author         User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([pageId, revisionNumber])
  @@index([pageId])
  @@index([authorId])
  @@map("cms_revisions")
}

model CmsAuditLog {
  id        String    @id @default(cuid())
  pageId    String?
  userId    String?
  userName  String?
  action    String
  details   Json?
  createdAt DateTime  @default(now())

  page      CmsPage?  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("cms_audit_logs")
}

model CmsMediaAsset {
  id           String    @id @default(cuid())
  url          String    @unique
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  caption      String?
  folder       String    @default("general")
  uploadedBy   String?

  uploader     User?     @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([folder])
  @@index([mimeType])
  @@index([createdAt])
  @@index([uploadedBy])
  @@map("cms_media_assets")
}

model CmsNavItem {
  id          String      @id @default(cuid())
  menu        NavMenu     @default(HEADER)
  label       String
  href        String
  order       Int         @default(0)
  isExternal  Boolean     @default(false)
  published   Boolean     @default(true)
  parentId    String?

  parent      CmsNavItem? @relation("NavItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    CmsNavItem[] @relation("NavItemHierarchy")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([menu, published, order])
  @@map("cms_nav_items")
}

model CmsAppearance {
  id             Int      @id @default(1)
  primaryColor   String   @default("#0f766e")
  secondaryColor String   @default("#d97706")
  accentColor    String   @default("#f59e0b")
  fontHeading    String   @default("font-heading")
  fontBody       String   @default("font-sans")
  buttonRadius   String   @default("rounded-xl")
  containerWidth String   @default("max-w-7xl")
  headerSticky   Boolean  @default(true)
  footerTheme    String   @default("dark")
  logoUrl        String?
  logoDarkUrl    String?
  faviconUrl     String?

  updatedAt      DateTime @updatedAt

  @@map("cms_appearance")
}
