# Environment variables declared in this file are NOT automatically loaded by Prisma CLI commands;
# prisma.config.ts imports "dotenv/config" explicitly to load them.

DATABASE_URL="postgresql://livinghope:livinghope@localhost:5442/livinghope?schema=public"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend (https://resend.com/api-keys) — transactional email for receipts
RESEND_API_KEY=""
EMAIL_FROM=""

# File storage: "local" (default, dev only) or "vercel-blob"
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

NEXT_PUBLIC_APP_URL="http://localhost:3010"
